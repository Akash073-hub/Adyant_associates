# Copy this file to .env and fill in real values. Never commit .env.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPOSITORY=your-github-owner/your-data-repository
ADMIN_PASSWORD=replace_with_a_long_unique_password
DEVELOPER_ACCESS_EMAIL=your-developer-email@example.com
SUPPORT_EMAIL=akashrbhat73@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sending-gmail-address@gmail.com
# For Gmail, use an App Password here, not your normal account password.
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sending-gmail-address@gmail.com
GITHUB_DATA_PATH=data/store.json
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
PORT=5000
# Razorpay payment gateway credentials (keep RAZORPAY_KEY_SECRET private on the server)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR
MOCK_INTERVIEW_FEE_INR=1999
AI_QA_PROGRAM_FEE_INR=4999
INTERVIEW_PREP_FEE_INR=2499
